# Supabase를 사용할 때 아래 값을 .env 파일로 복사해 설정합니다.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# supabase-schema.sql 실행 후 true로 설정하면 원격 DB를 사용합니다.
# 설정하지 않으면 기존 data/*.json 샘플을 사용하는 로컬 모드입니다.
USE_SUPABASE=true

# Supabase Auth 로그인 이메일과 일치할 때 관리자 권한을 부여합니다.
ADMIN_EMAIL=eunjin.thedot@gmail.com
